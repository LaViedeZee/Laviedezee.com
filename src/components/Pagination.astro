---
// WordPress paginate_links() output (mid_size 1, end_size 1) as the
// homepage uses it: numbered links with dots between gaps, plus prev/next.
// Page 1 lives at the base URL itself; later pages at {base}page/{n}/.
interface Props {
	current: number;
	total: number;
	// Base URL of the archive, with trailing slash, e.g. "https://laviedezee.com/"
	base: string;
}

const { current, total, base } = Astro.props;
const pageUrl = (n: number) => (n === 1 ? base : `${base}page/${n}/`);

// The page numbers WP shows: first, last, and current +/- 1.
const shown = new Set<number>([1, total]);
for (let n = current - 1; n <= current + 1; n++) {
	if (n >= 1 && n <= total) shown.add(n);
}
const pages = [...shown].sort((a, b) => a - b);
---

{
	total > 1 && (
		<nav class="navigation pagination" aria-label="Posts pagination">
			<h2 class="screen-reader-text">Posts pagination</h2>
			<div class="nav-links">
				{current > 1 && (
					<a class="prev page-numbers" href={pageUrl(current - 1)}>
						&lt;
					</a>
				)}
				{pages.map((n, i) => (
					<>
						{i > 0 && pages[i - 1] < n - 1 && (
							<span class="page-numbers dots">&hellip;</span>
						)}
						{n === current ? (
							<span
								aria-label={`Page ${n}`}
								aria-current="page"
								class="page-numbers current"
							>
								{n}
							</span>
						) : (
							<a aria-label={`Page ${n}`} class="page-numbers" href={pageUrl(n)}>
								{n}
							</a>
						)}
					</>
				))}
				{current < total && (
					<a class="next page-numbers" href={pageUrl(current + 1)}>
						&gt;
					</a>
				)}
			</div>
		</nav>
	)
}
